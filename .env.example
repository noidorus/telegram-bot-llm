# Telegram bot process
TELEGRAM_BOT_TOKEN=
LLM_INFERENCE_URL=http://localhost:3001

# LLM inference process
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:1.7b
LLM_BASE_URL=http://localhost:11434
# Optional, defaults to 3001. Port for the inference HTTP server; should match LLM_INFERENCE_URL above.
LLM_INFERENCE_PORT=3001
